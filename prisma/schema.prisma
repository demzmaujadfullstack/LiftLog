generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  OTHER
}

enum ExerciseType {
  STRENGTH
  BODYWEIGHT
  CARDIO
  ISOLATION
  OLYMPIC
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RecordType {
  MAX_WEIGHT
  MAX_REPS
  MAX_E1RM
}

enum PhotoAngle {
  FRONT
  SIDE
  BACK
}

enum MealCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum GoalType {
  BODY_WEIGHT
  BENCH_PRESS
  SQUAT
  DEADLIFT
  WEEKLY_WORKOUTS
  EXERCISE_WEIGHT
  OTHER
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum DailyGoalType {
  WORKOUT
  CALORIES
  PROTEIN
  WATER
  STEPS
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  suspended     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  resetTokens      PasswordResetToken[]
  exercises        Exercise[]
  programs         WorkoutProgram[]
  workoutSessions  WorkoutSession[]
  personalRecords  PersonalRecord[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]
  foodItems        FoodItem[]
  nutritionLogs    NutritionLog[]
  nutritionTarget  NutritionTarget?
  goals            UserGoal[]
  dailyGoals       DailyGoal[]
  notifications    Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id         String    @id @default(cuid())
  userId     String    @unique
  heightCm   Float?
  birthDate  DateTime?
  gender     String?
  bio        String?
  avatarUrl  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id               String        @id @default(cuid())
  name             String
  description      String?       @db.Text
  primaryMuscle    MuscleGroup
  secondaryMuscles MuscleGroup[]
  equipment        Equipment
  type             ExerciseType
  instructions     String?       @db.Text
  difficulty       Difficulty    @default(BEGINNER)
  isSystem         Boolean       @default(false)
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  createdBy       User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  workoutExercises WorkoutExercise[]
  programExercises ProgramExercise[]
  personalRecords  PersonalRecord[]
  goals            UserGoal[]

  @@index([primaryMuscle])
  @@index([createdById])
  @@index([isSystem])
}

model WorkoutProgram {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?   @db.Text
  template    String?
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  days            WorkoutDay[]

  @@index([userId])
}

model WorkoutDay {
  id       String @id @default(cuid())
  programId String
  name     String
  dayIndex Int    @default(0)

  program         WorkoutProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises       ProgramExercise[]
  workoutSessions WorkoutSession[]

  @@unique([programId, dayIndex])
}

model ProgramExercise {
  id             String  @id @default(cuid())
  dayId          String
  exerciseId     String
  order          Int     @default(0)
  targetSets     Int     @default(3)
  targetRepsMin  Int?
  targetRepsMax  Int?
  targetWeightKg Float?
  restSeconds    Int?

  day      WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@index([exerciseId])
}

model WorkoutSession {
  id              String    @id @default(cuid())
  userId          String
  title           String
  notes           String?   @db.Text
  performedAt     DateTime  @default(now())
  completedAt     DateTime?
  durationMinutes Int?
  totalVolumeKg   Float     @default(0)
  programDayId    String?
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  programDay   WorkoutDay?   @relation(fields: [programDayId], references: [id], onDelete: SetNull)
  exercises WorkoutExercise[]

  @@index([userId, performedAt])
}

model WorkoutExercise {
  id        String  @id @default(cuid())
  sessionId String
  exerciseId String
  order     Int     @default(0)
  notes     String? @db.Text

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets     WorkoutSet[]

  @@unique([sessionId, exerciseId, order])
  @@index([sessionId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String  @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  reps              Int
  weightKg          Float   @default(0)
  rpe               Float?
  isWarmup          Boolean @default(false)
  isBodyweight      Boolean @default(false)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

model PersonalRecord {
  id           String     @id @default(cuid())
  userId       String
  exerciseId   String
  type         RecordType
  value        Float
  weightKg     Float?
  reps         Int?
  achievedAt   DateTime   @default(now())
  sessionId    String?
  createdAt    DateTime   @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId, type])
  @@index([userId])
}

model BodyMeasurement {
  id             String    @id @default(cuid())
  userId         String
  date           DateTime  @default(now())
  weightKg       Float?
  heightCm       Float?
  chestCm        Float?
  waistCm        Float?
  armCm          Float?
  forearmCm      Float?
  thighCm        Float?
  calfCm         Float?
  bodyFatPercent Float?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model ProgressPhoto {
  id         String     @id @default(cuid())
  userId     String
  angle      PhotoAngle
  takenAt    DateTime   @default(now())
  url        String
  storageKey String?
  notes      String?    @db.Text
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

model FoodItem {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  brand        String?
  caloriesKcal Float    @default(0)
  proteinG     Float    @default(0)
  carbsG       Float    @default(0)
  fatG         Float    @default(0)
  servingSizeG Float    @default(100)
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nutritionLogs NutritionLog[]

  @@index([userId])
  @@index([isSystem])
}

model NutritionTarget {
  id           String   @id @default(cuid())
  userId       String   @unique
  caloriesKcal Float    @default(2200)
  proteinG     Float    @default(140)
  carbsG       Float    @default(250)
  fatG         Float    @default(70)
  waterMl      Float    @default(2500)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NutritionLog {
  id           String       @id @default(cuid())
  userId       String
  date         DateTime
  meal         MealCategory @default(SNACK)
  foodItemId   String?
  name         String
  servings     Float        @default(1)
  caloriesKcal Float        @default(0)
  proteinG     Float        @default(0)
  carbsG       Float        @default(0)
  fatG         Float        @default(0)
  waterMl      Float        @default(0)
  idempotencyKey String?    @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model UserGoal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  type        GoalType   @default(OTHER)
  exerciseId  String?
  startValue  Float?
  targetValue Float
  currentValue Float?
  unit        String?
  deadline    DateTime?
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise   Exercise?        @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  milestones GoalMilestone[]

  @@index([userId, status])
}

model GoalMilestone {
  id     String   @id @default(cuid())
  goalId String
  value  Float
  note   String?
  date   DateTime @default(now())

  goal UserGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model DailyGoal {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  type      DailyGoalType
  target    Float
  current   Float         @default(0)
  completed Boolean       @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
